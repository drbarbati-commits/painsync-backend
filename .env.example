# PainSync Backend — Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string
# For Railway: this is auto-populated as $DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/painsync

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── AI (OpenAI-compatible — free with Gemini) ───────────────────────────────
# Option A: Use Gemini 2.5 Flash (FREE)
#   1. Get a free API key at https://aistudio.google.com/app/apikey
#   2. Set OPENAI_API_KEY to your Google AI key
#   3. Set OPENAI_BASE_URL to the Gemini OpenAI-compatible endpoint
OPENAI_API_KEY=your-google-ai-studio-api-key
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash

# Option B: Use OpenAI GPT-4o-mini (paid but cheap)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ─── Sentry ──────────────────────────────────────────────────────────────────
# https://docs.sentry.io/product/sentry-basics/dsn-explainer/
SENTRY_DSN=

# ─── App Settings ────────────────────────────────────────────────────────────
DEBUG=false
